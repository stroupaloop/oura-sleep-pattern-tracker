# App auth (magic link login)
NEXTAUTH_SECRET=             # Run: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
RESEND_API_KEY=              # From https://resend.com/api-keys
EMAIL_FROM=                  # MUST be on a domain verified at resend.com/domains
ALLOWED_EMAILS=              # Comma-separated, e.g. you@email.com,them@email.com
SENSITIVE_EMAILS=            # Comma-separated private viewers; first email owns the detection profile

# Oura OAuth (ring data connection)
OURA_CLIENT_ID=              # From https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_SECRET=          # From https://cloud.ouraring.com/oauth/applications

# Database (Turso)
TURSO_DATABASE_URL=           # From https://turso.tech dashboard, e.g. libsql://your-db.turso.io
TURSO_AUTH_TOKEN=             # From: turso db tokens create your-db-name

# Twilio (SMS notifications - optional)
TWILIO_ACCOUNT_SID=           # From https://console.twilio.com
TWILIO_AUTH_TOKEN=            # From https://console.twilio.com
TWILIO_PHONE_NUMBER=          # Your Twilio phone number, e.g. +1234567890

# Cron
CRON_SECRET=                  # Run: openssl rand -base64 32

# Resend sender — MUST be a verified domain. The resend.dev fallback only
# delivers to the Resend account owner, so magic links silently fail without it.
AUTH_RESEND_KEY=             # Preferred over RESEND_API_KEY when both are set
AUTH_SECRET=                 # Preferred over NEXTAUTH_SECRET; also seeds the thought schedule

# "Thinking of you" page
THOUGHTS_AUTHOR_EMAILS=       # Comma-separated; who may log/edit thoughts. Defaults to first ALLOWED_EMAILS entry
THOUGHTS_AUTO_ENABLED=       # "0" to turn off auto-generated entries
THOUGHTS_AUTO_MIN=1          # Auto entries per day, lower bound
THOUGHTS_AUTO_MAX=3          # Auto entries per day, upper bound
THOUGHTS_AUTO_START_HOUR=7   # ET window start
THOUGHTS_AUTO_END_HOUR=25    # ET window end, exclusive (25 = 1am next day)
THOUGHTS_AUTO_MIN_GAP_MIN=45 # Minimum spacing between auto entries

# Visit tracking + alerts
VISIT_ALERT_TO=              # Alert recipient for visits, sign-ins and daily logs; defaults to THOUGHTS_AUTHOR_EMAIL
VISIT_ALERTS_ENABLED=        # "0" to silence, "1" to force on outside production
VISIT_ALERT_WINDOW_MIN=5     # Do not re-alert for the same visitor within this many minutes
VISIT_TRACK_DEV=             # "1" to log visits outside production (dev shares the prod DB)
SIGNIN_ALERTS_ENABLED=       # "0" to silence sign-in alerts, "1" to force on outside production
DAILY_LOG_ALERTS_ENABLED=    # "0" to silence daily-log alerts, "1" to force on outside production
OURA_ALERTS_ENABLED=         # "0" to silence Oura sync-failure alerts, "1" to force on outside production
